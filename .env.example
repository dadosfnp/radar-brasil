ENV=production
SECRET_KEY=gere-uma-chave-forte-aqui
ALLOWED_HOSTS=radarbrasil.fnp.org.br
DATABASE_URL=postgresql://radarbrasil:<senha>@<host>.db.ondigitalocean.com:25060/radar_brasil?sslmode=require

# Credenciais da service account do Google Sheets (JSON em linha única)
# Necessário apenas para rodar: python manage.py sync_sheets_db
GOOGLE_SHEETS_CREDS_JSON={"type":"service_account",...}

# Assistente de dados (chat): Gemini, plano gratuito do Google AI Studio
# Chave em https://aistudio.google.com (Get API key). Nunca versionar.
GEMINI_API_KEY=
# Opcional: modelos em ordem de preferencia (o seguinte e usado quando o anterior
# responde 503 por alta demanda ou 429 por cota) e limites em janela de 24h
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Tempo maximo (s) por chamada ao Gemini e para a pergunta inteira, incluindo reservas
GEMINI_TIMEOUT_S=15
ASSISTENTE_ORCAMENTO_S=25
ASSISTENTE_LIMITE_IP_DIA=20
ASSISTENTE_LIMITE_TOTAL_DIA=500
# Dias que as interacoes ficam guardadas (LGPD; confirmar com o DPO). Limpeza: manage.py limpar_assistente
ASSISTENTE_RETENCAO_DIAS=90
