# ============================================================
# Radar Brasil — Template de variáveis de ambiente
# Copie para .env e preencha com os valores reais:
#   cp .env.example .env
# NUNCA versione o .env com valores reais.
# ============================================================

# ── Ambiente ──────────────────────────────────────────────
# Em produção (Render), defina como "production"
ENV=development

# ── Django ────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria

# Hosts separados por vírgula (em produção: seu domínio Render)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Banco de Dados ────────────────────────────────────────
# Em desenvolvimento: deixe em branco (usa SQLite automaticamente)
# Em produção (Render / Neon): cole a URL completa do PostgreSQL
DATABASE_URL=

# ── Google Sheets (dados do painel) ───────────────────────
# JSON de credenciais da conta de serviço do Google (em uma linha)
GOOGLE_SHEETS_CREDENTIALS=

# ID da planilha de parâmetros
SHEET_PARAMETROS_ID=
