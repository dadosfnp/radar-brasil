# ── Metodologia de Cálculo ─────────────────────────────────────
msgid "Metodologia de Cálculo"
msgstr "Calculation Methodology"

msgid "A Nota País é construída de forma progressiva: partimos da avaliação individual de cada instância (Nível Parcial) para, em seguida, consolidar por eixo (Nível Eixo) e, por fim, chegar à nota geral do país."
msgstr "The Country Score is built progressively: we start from the individual assessment of each instance (Partial Level), then consolidate by axis (Axis Level), and finally arrive at the country's overall score."

msgid "Nível Parcial"
msgstr "Partial Level"

msgid "Score de cada instância"
msgstr "Score for each instance"

msgid "Média aritmética dos valores atribuídos a cada critério de avaliação da instância, na escala de 1 a 5."
msgstr "Arithmetic mean of the values assigned to each assessment criterion of the instance, on a scale of 1 to 5."

msgid "Peso"
msgstr "Weight"

msgid "Escala"
msgstr "Scale"

msgid "Espaço de Diálogo"
